# Configurações do PostgreSQL (Supabase via Pooler - porta 6543)
POSTGRES_HOST=aws-0-us-east-1.pooler.supabase.com
POSTGRES_PORT=6543
POSTGRES_DATABASE=postgres
POSTGRES_USER=postgres.SEU_PROJECT_REF
POSTGRES_PASSWORD=sua-senha
POSTGRES_SSLMODE=require

# Ou use a connection string completa:
# DATABASE_URL=postgresql://postgres.SEU_PROJECT_REF:sua-senha@aws-0-us-east-1.pooler.supabase.com:6543/postgres
